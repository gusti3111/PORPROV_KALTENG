{
  "name": "porprov-kalteng-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && go run ./cmd/api",
    "build": "npm --prefix frontend run build && cd backend && go build -o bin/api ./cmd/api",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && go build -o bin/api ./cmd/api",
    "lint": "npm --prefix frontend run lint && cd backend && go vet ./...",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "cd backend && go vet ./...",
    "test:backend": "cd backend && go test -v ./...",
    "test": "cd backend && go test -v ./..."
  }
}
